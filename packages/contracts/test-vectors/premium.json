{
  "formulaVersion": "v1",
  "formulaVersionNumber": 1,
  "currency": "PHP",
  "moneyUnit": "centavos",
  "inputs": {
    "age": { "type": "integer", "minimum": 18, "maximum": 65 },
    "coverageAmount": { "type": "integer", "minimum": 500000, "maximum": 20000000, "unit": "whole pesos" },
    "termYears": { "type": "integer", "enum": [10, 20, 30] }
  },
  "formula": {
    "units": "coverageAmount / 1000",
    "baseRate": 0.70,
    "ageFactor": "1 + max(0, age - 25) * 0.032",
    "termFactor": "1 + (termYears - 10) * 0.012",
    "monthlyPremium": "units * baseRate * ageFactor * termFactor",
    "money": "integer centavos (1 peso = 100 centavos)"
  },
  "rounding": "Compute in integer centavos with round half up to the nearest whole centavo at the end. Worked on an exact rational: centavos = coverageAmount * 7 * (1000 + max(0, age - 25) * 32) * (1000 + (termYears - 10) * 12) / 100000000, then round half up. No floating-point money.",
  "example": "coverageAmount 2000000, age 30, termYears 20 gives 181888 centavos = \"1818.88\".",

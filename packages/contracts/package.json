{
  "name": "@autonomy/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAPI contract, lint rules, generated types, mock server and test vectors for Autonomy Insurance.",
  "scripts": {
    "lint": "spectral lint openapi.yaml --ruleset .spectral.yaml --fail-severity error",
    "lint:fixtures": "node scripts/check-lint-fixtures.mjs",
    "types": "openapi-typescript openapi.yaml -o generated/ts/api.d.ts && tsc --noEmit -p tsconfig.json",
    "mock": "prism mock openapi.yaml --port 4010 --host 127.0.0.1",
    "mock:smoke": "node scripts/mock-smoke.mjs",
    "test": "vitest run",
    "check": "npm run lint && npm run lint:fixtures && npm run types",
    "contract:check": "npm run check"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.14.2",
    "@stoplight/spectral-cli": "^6.17.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}

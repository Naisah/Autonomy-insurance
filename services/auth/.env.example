# Placeholders only. Copy to .env and edit. Never commit .env.
PORT=4001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autonomy_auth
# Paths to the RS256 key pair (generated locally, not in git)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ISSUER=autonomy-auth
CORS_ORIGIN=http://localhost:5173
# Service client secrets (hashed on store); placeholders only
CORE_SERVICE_SECRET=change-me
REWARDS_SERVICE_SECRET=change-me

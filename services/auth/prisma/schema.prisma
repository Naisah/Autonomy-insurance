// Auth database (autonomy_auth). Written from specs/04-data-model.md sections 1, 2, 5.
// Prisma cannot express CHECK constraints, partial indexes or the role/parent trigger;
// those are in prisma/migrations/20261128000000_init/migration.sql (hand-added after the generated SQL).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum Role {
  Admin
  Manager
  Agent
  Client
}

enum UserStatus {
  Active
  Deactivated
}

enum Availability {
  Available
  Away
}

enum SessionAudience {
  CoreApi
  RewardsApi
}

model User {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String        @unique @db.Citext
  passwordHash       String        @map("password_hash")
  fullName           String        @map("full_name")
  role               Role
  reportsTo          String?       @map("reports_to") @db.Uuid
  status             UserStatus    @default(Active)
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  availability       Availability?
  maxClients         Int?          @map("max_clients") @db.SmallInt
  waitingSince       DateTime?     @map("waiting_since") @db.Timestamptz(6)
  termsAcceptedAt    DateTime?     @map("terms_accepted_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   User?  @relation("ReportsTo", fields: [reportsTo], references: [id], onDelete: Restrict)
  children User[] @relation("ReportsTo")

  sessions Session[]
  ssoCodes SsoCode[]

  @@index([reportsTo])
  @@index([role, status])
  // partial index (waiting_since) WHERE waiting_since IS NOT NULL is added in the migration SQL
  @@map("users")
}

model Session {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  parentSid   String?         @map("parent_sid") @db.Uuid
  audience    SessionAudience
  deviceLabel String?         @map("device_label")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt   DateTime?       @map("revoked_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  parent        Session?       @relation("SsoParent", fields: [parentSid], references: [id], onDelete: Restrict)
  children      Session[]      @relation("SsoParent")
  refreshTokens RefreshToken[]
  ssoCodes      SsoCode[]

  @@index([userId])
  @@index([parentSid])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model SsoCode {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codeHash      String    @unique @map("code_hash")
  userId        String    @map("user_id") @db.Uuid
  parentSid     String    @map("parent_sid") @db.Uuid
  codeChallenge String    @map("code_challenge")
  clientId      String    @map("client_id")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)

  user          User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  parentSession Session @relation(fields: [parentSid], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([parentSid])
  @@map("sso_codes")
}

model LoginAttempt {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  succeeded Boolean
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt])
  @@map("login_attempts")
}

model ServiceAccount {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique
  secretHash String   @map("secret_hash")
  scopes     String[]
  audience   String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("service_accounts")
}

model AuthEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        String
  payload     Json
  version     Int
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)

  // partial index (created_at) WHERE delivered_at IS NULL for the delivery worker is added in the migration SQL
  @@map("auth_events")
}
